{
  "name": "sodam-policy-advisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env server/main.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/main.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0",
    "nodemailer": "10.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "@playwright/test": "1.64.0",
    "vite": "8.3.4"
  }
}
