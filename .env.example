# 개발용 예시입니다. 이 파일을 .env로 복사하고 실제 값은 본인 환경에서 입력합니다.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATA_DIR=/workspace/semas-data
# 최초 관리자 이메일. 실제 메일 수신이 가능한 주소로 설정합니다.
ADMIN_EMAIL=
# 인증번호 발송에 사용할 SMTP 설정. 비밀번호를 소스에 넣지 마세요.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TRUST_PROXY=0
